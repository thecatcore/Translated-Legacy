{
  "required": true,
  "package": "fr.catcore.translatedlegacy.ornithe.common.mixin",
  "plugin": "net.ornithemc.conditionalmixin.mixin.ConditionalMixinPlugin",
  "compatibilityLevel": "JAVA_8",
  "mixins": [
    "LanguageManagerMixin",
    "LocaleMixin",
    "SimpleLanguageMetadataSerializerMixin"
  ],
  "client": [
    "client.ChatMessagePacketMixin",
    "client.ChatScreenMixin",
    "client.DisconnectPacketMixin",
    "client.OpenInventoryMenuPacketMixin",
    "client.SignEditScreenMixin"
  ],
  "injectors": {

    "server.DisconnectPacketMixin",
    "server.OpenInventoryMenuPacketMixin",
    "server.ServerPlayerEntityMixin",
    "server.ServerPlayNetworkHandler_ChatHandlerMixin",
    "server.ServerPlayNetworkHandlerMixin"
  ],
  "mixinextras": {
    "minVersion": "0.5.0"
  }
}
